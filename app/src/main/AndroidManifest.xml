<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- fake flavor installs on a phone. pleos flavor requires an automotive device. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="${automotiveRequired}" />

    <application
        android:name=".FoundationApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Foundation">

        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <!-- CCP rotary is not used. Unknown meta-data is ignored on a phone. -->
        <meta-data
            android:name="com.hmg.rotary.ROTARY_SUPPORTED"
            android:value="false" />

        <!--
          Normal activity window, not an overlay. Default size is portrait 840×1184.
          Landscape is 1700×1184. Orientation is not locked, so a configuration change
          recreates this activity and ViewModel, rememberSaveable, and SavedStateHandle
          keep the form. The 840×1280 driving view stays a system area.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Required so the activity may stay visible outside Park. The UI must still reduce itself. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
