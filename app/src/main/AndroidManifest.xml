<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- fake flavor installs on a phone. pleos flavor requires an automotive device. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="${automotiveRequired}" />

    <!-- Vehicle SDK read APIs. All normal protection level. -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />

    <!-- NaviHelper. Normal protection level. -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- AAOS GEAR_SELECTION. Normal. Gear is not read from Vehicle.getGear(). -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!-- Optional RANGE_REMAINING. Dangerous. The Vehicle SDK has no range getter. -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />

    <application
        android:name=".FoundationApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Foundation">

        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Required so the activity may stay visible outside Park. The UI must still reduce itself. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
